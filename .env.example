# ===================================================
# ملف .env.example — نموذج متغيرات البيئة لـ Railway
# انسخ هذا الملف وأعد تسميته إلى .env ثم أضف قيمك الحقيقية
# على Railway: أضف هذه القيم في قسم Variables مباشرة
# ===================================================

# ✅ مطلوب — توكن بوت تليجرام (من @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 🌐 البوت مفتوح للاستخدام العام؛ لا حاجة لقائمة مستخدمين مسموحين

# ✅ مطلوب — مفاتيح Gemini API (أضف حتى 7 مفاتيح لتوزيع الحمل)
# الطريقة 1: مفاتيح مرقمة (موصى بها)
GEMINI_API_KEY_1=AIzaSy...your_first_key_here
GEMINI_API_KEY_2=AIzaSy...your_second_key_here
GEMINI_API_KEY_3=AIzaSy...your_third_key_here
GEMINI_API_KEY_4=AIzaSy...your_fourth_key_here
GEMINI_API_KEY_5=AIzaSy...your_fifth_key_here
GEMINI_API_KEY_6=AIzaSy...your_sixth_key_here
GEMINI_API_KEY_7=AIzaSy...your_seventh_key_here

# الطريقة 2: مفاتيح في سطر واحد مفصولة بفواصل (بديل للطريقة 1)
# GEMINI_API_KEYS=key1,key2,key3

# ⚙️ اختياري — نموذج Gemini المستخدم
GEMINI_MODEL=gemini-3.6-flash

# ⚙️ اختياري — مسار Chromium المثبت يدوياً على السيرفر
# على Railway يُكتشف تلقائياً عبر nixpacks.toml
# CHROME_BIN=/usr/bin/chromium

# ⚙️ Railway يضبط PORT تلقائياً — لا تغيّره
# PORT=3000

# 📚 ملف جلسات اختياري؛ على Railway استخدم Volume أو تخزيناً خارجياً لضمان البقاء بعد إعادة النشر
# SESSION_FILE=/data/sessions.json
